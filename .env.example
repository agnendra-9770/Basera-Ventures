# Public address of the site, no trailing slash. Used for canonical links, the sitemap and share cards.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Long random string that signs admin sessions. Keep it secret; never commit it.
PAYLOAD_SECRET=replace-with-a-long-random-string

# SQLite database file. For Turso (hosted libSQL) use libsql://... and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/site.db
DATABASE_AUTH_TOKEN=

# Optional: email notifications for new inquiries (any SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Where inquiry notifications go. Falls back to the email in Site settings → Contact.
INQUIRY_NOTIFY_EMAIL=
