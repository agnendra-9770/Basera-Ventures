# Public address of the site, no trailing slash. Used for canonical links, the sitemap and share cards.
SITE_URL=http://localhost:3000

# Long random string that signs admin sessions. Keep it secret; never commit it.
PAYLOAD_SECRET=replace-with-a-long-random-string

# Database. A SQLite file by default; for Turso (hosted libSQL) use libsql://... and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/site.db
DATABASE_AUTH_TOKEN=
# Postgres instead (e.g. Supabase → Connect): the transaction pooler for the site (port 6543)…
# DATABASE_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres"
# …and the session pooler (port 5432), used by `npm run migrate` and `npm run seed`.
# DIRECT_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres"
# Optional: Supabase's CA certificate (PEM, \n for line breaks) so the connection is verified, not just encrypted.
# DATABASE_CA_CERT=

# Optional: email notifications for new inquiries (any SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Where inquiry notifications go. Falls back to the email in Site settings → Contact.
INQUIRY_NOTIFY_EMAIL=
